# .graphifyignore
# Tells Graphify which files and directories to exclude from code graph analysis.
# Follows .gitignore-style glob patterns.

# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/

# ── Next.js build artifacts ───────────────────────────────────
.next/
out/
build/

# ── Graphify own output (avoid self-referential analysis) ─────
graphify-out/

# ── TypeScript build info ─────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Environment & secrets ─────────────────────────────────────
.env*

# ── Lock files (not source code) ─────────────────────────────
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Config / tooling boilerplate (low signal) ─────────────────
postcss.config.mjs
eslint.config.mjs
tsconfig.json
next.config.ts

# ── Static assets ─────────────────────────────────────────────
public/
*.ico
*.svg
*.png
*.jpg
*.webp

# ── Docs & markdown (not source logic) ────────────────────────
README.md
AGENTS.md
CLAUDE.md
prd.md
trd.md

# ── Misc OS & editor artifacts ────────────────────────────────
.DS_Store
*.pem
.vercel/
